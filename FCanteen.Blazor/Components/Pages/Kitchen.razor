@page "/kitchen"
@rendermode InteractiveServer

@using FCanteen.Data
@using FCanteen.Data.Entities
@using FCanteen.Blazor.Services
@using Microsoft.EntityFrameworkCore

@inject IDbContextFactory<FCanteenContext> DbFactory
@inject OrderStatusService OrderStatusService

@implements IDisposable

<PageTitle>Kitchen</PageTitle>

<h1>Màn hình bếp</h1>

<div class="row g-3">

    <div class="col-md-4">
        <h3>Chờ tiếp nhận (@waitingOrders.Count)</h3>

        @foreach (var order in waitingOrders)
        {
            <div class="card mb-3 @(IsOverdue(order) ? "border-danger bg-danger-subtle" : "")">
                <div class="card-body">
                    <h5>Đơn #@order.OrderTicketId</h5>

                    <div>
                        <strong>Quầy:</strong>
                        @order.CounterName
                    </div>

                    <div>
                        <strong>Thời gian chờ:</strong>
                        @GetElapsed(order.CreatedAt)
                    </div>

                    <hr />

                    <strong>Món:</strong>

                    <ul class="mb-2">
                        @foreach (var line in order.TicketLines)
                        {
                            <li>
                                @line.MenuItem.Name
                                x @line.Quantity

                                @if (!string.IsNullOrWhiteSpace(line.Note))
                                {
                                    <span class="text-muted">
                                        — @line.Note
                                    </span>
                                }
                            </li>
                        }
                    </ul>

                    @if (IsOverdue(order))
                    {
                        <div class="text-danger fw-bold">
                            ⚠ Đơn đã chờ quá 10 phút
                        </div>
                    }
                    <button class="btn btn-primary mt-2"
                            @onclick="() => ChangeStatusAsync(
                                    order.OrderTicketId,
                                    OrderStatuses.Preparing)">
                        Bắt đầu chế biến
                    </button>
                </div>
            </div>
        }
    </div>

    <div class="col-md-4">
        <h3>Đang chế biến (@preparingOrders.Count)</h3>

        @foreach (var order in preparingOrders)
        {
            <div class="card mb-3 @(IsOverdue(order) ? "border-danger bg-danger-subtle" : "")">
                <div class="card-body">
                    <h5>Đơn #@order.OrderTicketId</h5>

                    <div>
                        <strong>Quầy:</strong>
                        @order.CounterName
                    </div>

                    <div>
                        <strong>Thời gian chờ:</strong>
                        @GetElapsed(order.CreatedAt)
                    </div>

                    <hr />

                    <strong>Món:</strong>

                    <ul class="mb-2">
                        @foreach (var line in order.TicketLines)
                        {
                            <li>
                                @line.MenuItem.Name
                                x @line.Quantity

                                @if (!string.IsNullOrWhiteSpace(line.Note))
                                {
                                    <span class="text-muted">
                                        — @line.Note
                                    </span>
                                }
                            </li>
                        }
                    </ul>

                    @if (IsOverdue(order))
                    {
                        <div class="text-danger fw-bold">
                            ⚠ Đơn đã chờ quá 10 phút
                        </div>
                    }
                    <!-- Preparing -->
                    <button class="btn btn-warning mt-2"
                            @onclick="() => ChangeStatusAsync(
                                    order.OrderTicketId,
                                    OrderStatuses.Ready)">
                        Đánh dấu sẵn sàng
                    </button>
                </div>
            </div>
        }
    </div>

    <div class="col-md-4">
        <h3>Sẵn sàng (@readyOrders.Count)</h3>

        @foreach (var order in readyOrders)
        {
            <div class="card mb-3 @(IsOverdue(order) ? "border-danger bg-danger-subtle" : "")">
                <div class="card-body">
                    <h5>Đơn #@order.OrderTicketId</h5>

                    <div>
                        <strong>Quầy:</strong>
                        @order.CounterName
                    </div>

                    <div>
                        <strong>Thời gian chờ:</strong>
                        @GetElapsed(order.CreatedAt)
                    </div>

                    <hr />

                    <strong>Món:</strong>

                    <ul class="mb-2">
                        @foreach (var line in order.TicketLines)
                        {
                            <li>
                                @line.MenuItem.Name
                                x @line.Quantity

                                @if (!string.IsNullOrWhiteSpace(line.Note))
                                {
                                    <span class="text-muted">
                                        — @line.Note
                                    </span>
                                }
                            </li>
                        }
                    </ul>

                    @if (IsOverdue(order))
                    {
                        <div class="text-danger fw-bold">
                            ⚠ Đơn đã chờ quá 10 phút
                        </div>
                    }
                    <!-- Ready -->
                    <button class="btn btn-success mt-2"
                            @onclick="() => ChangeStatusAsync(
                                    order.OrderTicketId,
                                    OrderStatuses.Delivered)">
                        Đã giao
                    </button>
                </div>
            </div>
        }
    </div>

</div>

@code {
    private List<OrderTicket> waitingOrders = [];
    private List<OrderTicket> preparingOrders = [];
    private List<OrderTicket> readyOrders = [];
    private System.Threading.Timer? _timer;

    protected override async Task OnInitializedAsync()
    {
        await LoadOrdersAsync();

        _timer = new System.Threading.Timer(
            _ => _ = RefreshAsync(),
            null,
            TimeSpan.FromSeconds(5),
            TimeSpan.FromSeconds(5));
    }

    private async Task LoadOrdersAsync()
    {
        await using var db =
            await DbFactory.CreateDbContextAsync();

        var orders =
            await db.OrderTickets
                .AsNoTracking()
                .Include(x => x.TicketLines)
                    .ThenInclude(x => x.MenuItem)
                .Where(x =>
                    x.Status == OrderStatuses.Waiting ||
                    x.Status == OrderStatuses.Preparing ||
                    x.Status == OrderStatuses.Ready)
                .OrderBy(x => x.CreatedAt)
                .ToListAsync();

        waitingOrders =
            orders
                .Where(x => x.Status == OrderStatuses.Waiting)
                .ToList();

        preparingOrders =
            orders
                .Where(x => x.Status == OrderStatuses.Preparing)
                .ToList();

        readyOrders =
            orders
                .Where(x => x.Status == OrderStatuses.Ready)
                .ToList();
    }

    private async Task ChangeStatusAsync(
    int orderId,
    string newStatus)
    {
        var changed =
            await OrderStatusService.ChangeStatusAsync(
                orderId,
                newStatus,
                "Kitchen");

        if (changed)
        {
            await LoadOrdersAsync();
        }
    }

    private async Task RefreshAsync()
    {
        await InvokeAsync(
            async () =>
            {
                await LoadOrdersAsync();
                StateHasChanged();
            });
    }

    public void Dispose()
    {
        _timer?.Dispose();
    }

    private static bool IsOverdue(OrderTicket order)
    {
        return DateTime.Now - order.CreatedAt >
               TimeSpan.FromMinutes(10);
    }

    private static string GetElapsed(DateTime createdAt)
    {
        var elapsed = DateTime.Now - createdAt;

        return elapsed.TotalHours >= 1
            ? $"{(int)elapsed.TotalHours} giờ {elapsed.Minutes} phút"
            : $"{elapsed.Minutes} phút {elapsed.Seconds} giây";
    }
}