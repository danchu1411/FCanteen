@page "/kitchen"
@rendermode InteractiveServer

@using FCanteen.Data
@using FCanteen.Data.Entities
@using FCanteen.Blazor.Services
@using Microsoft.EntityFrameworkCore

@inject IDbContextFactory<FCanteenContext> DbFactory
@inject OrderStatusService OrderStatusService

@implements IDisposable

<PageTitle>Kitchen</PageTitle>

<h1>Màn hình bếp</h1>

<div class="row g-3">

    <div class="col-md-4">

        <h3>
            Chờ tiếp nhận
            (@waitingOrders.Count)
        </h3>

        @foreach (var order in waitingOrders)
        {
            <OrderCard Order="@order"
                       OnStatusChanged="HandleStatusChangedAsync" />
        }

    </div>

    <div class="col-md-4">

        <h3>
            Đang chế biến
            (@preparingOrders.Count)
        </h3>

        @foreach (var order in preparingOrders)
        {
            <OrderCard Order="@order"
                       OnStatusChanged="HandleStatusChangedAsync" />
        }

    </div>

    <div class="col-md-4">

        <h3>
            Sẵn sàng
            (@readyOrders.Count)
        </h3>

        @foreach (var order in readyOrders)
        {
            <OrderCard Order="@order"
                       OnStatusChanged="HandleStatusChangedAsync" />
        }

    </div>

</div>

@code {
    private List<OrderTicket> waitingOrders = [];
    private List<OrderTicket> preparingOrders = [];
    private List<OrderTicket> readyOrders = [];

    private System.Threading.Timer? _timer;

    protected override async Task OnInitializedAsync()
    {
        await LoadOrdersAsync();

        _timer = new System.Threading.Timer(
            _ => _ = RefreshAsync(),
            null,
            TimeSpan.FromSeconds(5),
            TimeSpan.FromSeconds(5));
    }

    private async Task LoadOrdersAsync()
    {
        await using var db =
            await DbFactory.CreateDbContextAsync();

        var orders =
            await db.OrderTickets
                .AsNoTracking()
                .Include(x => x.TicketLines)
                    .ThenInclude(x => x.MenuItem)
                .Where(x =>
                    x.Status == OrderStatuses.Waiting ||
                    x.Status == OrderStatuses.Preparing ||
                    x.Status == OrderStatuses.Ready)
                .OrderBy(x => x.CreatedAt)
                .ToListAsync();

        waitingOrders =
            orders
                .Where(x =>
                    x.Status ==
                    OrderStatuses.Waiting)
                .ToList();

        preparingOrders =
            orders
                .Where(x =>
                    x.Status ==
                    OrderStatuses.Preparing)
                .ToList();

        readyOrders =
            orders
                .Where(x =>
                    x.Status ==
                    OrderStatuses.Ready)
                .ToList();
    }

    private async Task HandleStatusChangedAsync(
        int orderId)
    {
        var order =
            waitingOrders
                .Concat(preparingOrders)
                .Concat(readyOrders)
                .FirstOrDefault(
                    x =>
                        x.OrderTicketId ==
                        orderId);

        if (order is null)
        {
            return;
        }

        string? newStatus =
            order.Status switch
            {
                OrderStatuses.Waiting =>
                    OrderStatuses.Preparing,

                OrderStatuses.Preparing =>
                    OrderStatuses.Ready,

                OrderStatuses.Ready =>
                    OrderStatuses.Delivered,

                _ =>
                    null
            };

        if (newStatus is null)
        {
            return;
        }

        var changed =
            await OrderStatusService
                .ChangeStatusAsync(
                    orderId,
                    newStatus,
                    "Kitchen");

        if (changed)
        {
            await LoadOrdersAsync();
        }
    }

    private async Task RefreshAsync()
    {
        await InvokeAsync(
            async () =>
            {
                await LoadOrdersAsync();

                StateHasChanged();
            });
    }

    public void Dispose()
    {
        _timer?.Dispose();
    }
}