@model FCanteen.Web.Models.IngredientPurchaseIndexViewModel

@{
    ViewData["Title"] = "Nhập nguyên liệu";
}

<h1>Nhập nguyên liệu</h1>

@if (TempData["PurchaseSuccess"] is string success)
{
    <div class="alert alert-success">
        @success
    </div>
}

@if (TempData["PurchaseError"] is string error)
{
    <div class="alert alert-danger">
        @error
    </div>
}

<div class="d-flex
    justify-content-between
    align-items-center
    mb-3">

    <p class="mb-0 text-muted">
        Chọn nguyên liệu và số lượng cần nhập.
    </p>

    <a asp-action="Cart"
       class="btn btn-outline-primary">

        Xem giỏ nhập

        <span class="badge bg-primary">
            @Model.CartLineCount
        </span>
    </a>
</div>

<table class="table
    table-bordered
    table-striped
    align-middle">

    <thead>
        <tr>
            <th>Nguyên liệu</th>
            <th>Nhà cung cấp</th>
            <th>Tồn kho</th>
            <th>Đơn vị</th>
            <th>Đơn giá</th>
            <th style="width: 250px;">
                Thêm vào giỏ
            </th>
        </tr>
    </thead>

    <tbody>

        @foreach (var item
            in Model.Ingredients)
        {
            <tr>

                <td>
                    @item.Name
                </td>

                <td>
                    @(item.Supplier?.Name
                        ?? "Chưa gán")
                </td>

                <td>
                    @item.StockQuantity.ToString("N2")
                </td>

                <td>
                    @item.Unit
                </td>

                <td>
                    @item.UnitCost.ToString("N0")
                    VND
                </td>

                <td>

                    <form asp-action="Add"
                          method="post"
                          class="d-flex gap-2">

                        <input type="hidden"
                               name="ingredientId"
                               value="@item.IngredientId" />

                        <input type="number"
                               name="quantity"
                               value="1"
                               min="0.01"
                               step="0.01"
                               class="form-control" />

                        <button type="submit"
                                class="btn btn-primary">
                            Thêm
                        </button>

                    </form>

                </td>

            </tr>
        }

    </tbody>

</table>